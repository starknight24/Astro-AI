# Actual values live in per-package env files, NOT this repo root:
#   web/.env  (frontend, VITE_-prefixed vars only)
#   api/.env  (server, secrets)
# This file lists variable *names* only.

# --- web/.env ---
# Public Supabase URL and the publishable anon key (sb_publishable_...).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# API base URL. Empty in dev (vite proxy handles /api and /health).
VITE_API_URL=

# --- api/.env ---
# Supabase project URL (used to fetch the JWKS for verifying user JWTs).
SUPABASE_URL=
# Postgres connection string. SECRET — server-side only.
DATABASE_URL=
# Google Generative AI key. SECRET — server-side only.
GEMINI_API_KEY=
# Allowed browser origin for CORS.
WEB_ORIGIN=
# Base URL of the Python science service (FastAPI). REQUIRED — the API fails
# fast at startup if missing. Set in api/.env for local dev and in the
# production environment settings (e.g. Fly/Render/Vercel dashboard).
SCIENCE_URL=
# NASA Open API key for the agent's apod/neo_lookup tools. Optional: defaults to
# NASA's shared DEMO_KEY, which is capped at ~30 requests/hour/IP (the 1-hour
# response cache absorbs most of that). Get a free key at api.nasa.gov.
NASA_API_KEY=
# Optional Gemini token prices in USD per million tokens. When either is unset,
# agent_traces.cost_usd is recorded as NULL rather than a guessed number.
GEMINI_INPUT_USD_PER_MTOK=
GEMINI_OUTPUT_USD_PER_MTOK=
# Sentry DSN for the API. Optional: error reporting is disabled when unset, so
# development and CI need no account. Request bodies, headers, query strings and
# user info are stripped before send (see api/src/lib/observability.ts).
SENTRY_DSN=
# Trace sample rate, 0..1. Default 0.05 — LLM latency and tokens are already
# recorded exactly in agent_traces, so paying a second vendor to re-measure them
# would be duplication.
SENTRY_TRACES_SAMPLE_RATE=
# Commit SHA, attached to Sentry events as the release.
GIT_SHA=

# Comma-separated Supabase user ids allowed to read /api/admin/metrics. UNSET
# DISABLES THE ROUTE ENTIRELY (it returns 404), so a misconfigured deploy fails
# closed rather than exposing cost and latency data.
ADMIN_USER_IDS=

# Supabase service-role key and bucket, for storing uploaded PDFs. Optional:
# ingestion reads the uploaded bytes directly, so a missing bucket costs the
# ability to re-download an original, not the ability to answer questions.
# SECRET — server-side only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Override the model used by the agent, the paper answerer and the judge. Useful
# because the Gemini free tier caps generateContent at 20 requests/day/model.
AGENT_MODEL=
RAG_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=

# --- web/.env (additional) ---
# Sentry DSN for the SPA. Baked in at build time; unset disables reporting.
VITE_SENTRY_DSN=
# Commit SHA, attached as the release.
VITE_GIT_SHA=
